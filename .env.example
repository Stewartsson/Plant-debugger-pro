# =========================================================
# Plant Debugger Pro Environment Configuration
# =========================================================

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Decision Engine Configuration
DECISION_ENGINE=adk
ADK_FALLBACK_POLICY=false
ADK_SESSION_BACKEND=local    # Options: 'firestore' or 'local'

# Multimodal Vision Configuration
VISION_ENGINE=gemini
VISION_FALLBACK_POLICY=false

# Persistence Layer Configuration
FIELD_STATE_BACKEND=local     # Options: 'firestore' or 'local'
FIELD_EVIDENCE_BACKEND=local  # Options: 'gcs' or 'local'
GCS_EVIDENCE_BUCKET=plant-debugger-evidence

# Google Cloud Platform (Optional when running with cloud backends)
GOOGLE_CLOUD_PROJECT=
PUBSUB_TOPIC=plant-anomaly-events

# Runtime
HOST=0.0.0.0
PORT=8000
SIMULATION_TICK_SECONDS=1.0
